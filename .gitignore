# ==========================================
# Git Ignore Configuration
# ==========================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build & Outputs
/.next/
/.svelte-kit/
/out/
/build/
*.tsbuildinfo
next-env.d.ts

# Testing & Coverage
/coverage

# Environment Variables & Secrets
.env*
!.env.example
*.env
*.secret
*.key
*.pem
*.crt
key_raw.txt
private.key
cert.key
Sslkey*

# Sensitive Operational & Service Data
server_logs.json
availability.json
whitelist.json
ddns_state.json
auto_patch.sh
session_history_summary.txt
GEMINI.md
/data/
/public/uploads/*
!/public/uploads/.gitkeep

# SonarQube & Scanners
.scannerwork/
.sonar/
sonar_issues.json
dependency-check-report.*

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS & IDE Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Misc
.vercel
