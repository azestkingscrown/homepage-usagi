# ==========================================
# Environment Variables Example (.env.local)
# ==========================================

# Auth & Discord OAuth2
NEXTAUTH_URL=https://example.com
NEXTAUTH_SECRET=replace-with-32byte-random-hex
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# Owner & Admin Discord IDs (comma-separated for ADMIN_DISCORD_IDS)
DISCORD_OWNER_ID=your-discord-user-id
ADMIN_DISCORD_IDS=your-discord-user-id

# Admin TOTP & Passwords
ADMIN_OTP_SECRET=replace-with-base32-totp-secret
ADMIN_PASSWORD=replace-with-admin-password
SERVER_PASSWORD=replace-with-server-password

# Origin & Security
TRUSTED_ORIGINS=https://example.com,https://www.example.com,https://chzzk.example.com

# Cloudflare DDNS
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id
DDNS_ROOT_DOMAIN=example.com
DDNS_SUBDOMAINS=device1.example.com,device2.example.com
DDNS_SECRET_TOKEN=replace-with-random-token
DDNS_DEFAULT_IP=192.0.2.1

# Server Monitoring Agents
TABLET_MONITOR_TOKEN=replace-with-random-token
MINI_MONITOR_TOKEN=replace-with-random-token
GCP_AGENT_URL=http://127.0.0.1:3001/metrics
NET_INTERFACE=eth0

# Minecraft Docker Container
MC_CONTAINER_NAME=minecraft-server
